rules_version = '2';

/**
 * LikBy Production Cloud Firestore Security Rules
 * Project: likby-2026
 *
 * Authoritative Model:
 * - Supabase is authoritative for relational users, friendships, and subscriptions.
 * - Firestore is authoritative for conversation messages and ordered session events.
 * - FastAPI backend uses privileged Firebase Admin SDK (service account) which automatically
 *   bypasses these security rules.
 * - These rules ensure zero unauthorized client reads and completely prevent direct client writes,
 *   enforcing that all conversation lifecycle state transitions pass through the FastAPI backend.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION & ROLE HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isSessionParticipant(sessionId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participants;
    }

    // ==========================================
    // SESSIONS & CONVERSATION TOPOLOGY
    // ==========================================

    match /sessions/{sessionId} {
      // Only authenticated participants or admin staff can read session metadata
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      
      // All writes (creation, sequence allocation, termination) must originate 
      // authoritatively from FastAPI backend via Firebase Admin SDK
      allow write: if false;

      // ------------------------------------------
      // Messages Subcollection
      // sessions/{sessionId}/messages/{messageId}
      // ------------------------------------------
      match /messages/{messageId} {
        // Only active session participants or staff can read messages
        allow read: if isAuthenticated() && (
          isSessionParticipant(sessionId) || isAdmin()
        );
        
        // Direct client writes are blocked; all message forwarding passes 
        // through FastAPI validation, rate limiting, and outbox persistence
        allow write: if false;
      }

      // ------------------------------------------
      // Events Subcollection
      // sessions/{sessionId}/events/{eventId}
      // ------------------------------------------
      match /events/{eventId} {
        // System and moderation events can only be read by authorized participants or staff
        allow read: if isAuthenticated() && (
          isSessionParticipant(sessionId) || isAdmin()
        );
        
        // System event writes are strictly server-side
        allow write: if false;
      }
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
