rules_version = '2';

/**
 * LikBy Production Cloud Firestore Security Rules
 * Project: likby-2026
 *
 * Authoritative Model:
 * - Supabase is authoritative for relational users, friendships, and subscriptions.
 * - Firestore is authoritative for conversation messages and ordered session events.
 * - FastAPI backend uses privileged Firebase Admin SDK (service account) which automatically
 *   bypasses these security rules.
 * - These rules ensure zero unauthorized client reads and completely prevent direct client writes,
 *   enforcing that all conversation lifecycle state transitions pass through the FastAPI backend.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION & ROLE HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isSessionParticipant(sessionId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/chat_sessions/$(sessionId)) && request.auth.uid in get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.participant_ids) ||
        (exists(/databases/$(database)/documents/sessions/$(sessionId)) && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participants)
      );
    }

    // ==========================================
    // CHAT SESSIONS & CONVERSATION TOPOLOGY
    // ==========================================

    match /chat_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participant_ids || isAdmin()
      );
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isSessionParticipant(sessionId) || isAdmin()
        );
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          isSessionParticipant(sessionId) || isAdmin()
        );
        allow write: if false;
      }
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isSessionParticipant(sessionId) || isAdmin()
        );
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          isSessionParticipant(sessionId) || isAdmin()
        );
        allow write: if false;
      }
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
