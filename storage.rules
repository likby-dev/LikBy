rules_version = '2';

/**
 * LikBy Cloud Storage Security Rules
 * Project: likby-2026
 *
 * Media Storage Authority:
 * Binary assets (photos, videos, audio, voice notes) are stored securely
 * in private Cloudflare R2 / Firebase Storage buckets.
 * Direct public/client access is disabled; all access requires pre-signed URLs
 * generated by the authenticated FastAPI backend.
 */
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Direct client upload and download are prohibited
      // All media handling is brokered by the FastAPI MediaService
      allow read, write: if false;
    }
  }
}
