# ==========================================
# LIKBY APPLICATION CONFIGURATION (.env.example)
# ==========================================
APP_NAME=LikBy
ENVIRONMENT=development # "development", "testing", "staging", "production"
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# ==========================================
# SERVER NETWORKING & PUBLIC URL
# ==========================================
HOST=0.0.0.0
PORT=8000
BASE_URL=https://your-domain.onrender.com

# ==========================================
# TELEGRAM BOT & WEBAPP
# ==========================================
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
WEBHOOK_SECRET_TOKEN=change_me_to_a_random_32_char_hex_string
BOT_MODE=polling # "polling" for local development, "webhook" for production
TELEGRAM_MINI_APP_URL=https://your-domain.onrender.com/play
TELEGRAM_MAX_DOWNLOAD_BYTES=20971520 # 20 MB

# ==========================================
# SUPABASE POSTGRESQL (Relational Store)
# ==========================================
DATABASE_BACKEND=sqlite # "sqlite" for local testing, "postgres" for production
DATABASE_URL=sqlite+aiosqlite:///likby.db
DATABASE_DIRECT_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-pass@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_POOL_MIN=1
SUPABASE_DB_POOL_MAX=5

# ==========================================
# FIREBASE FIRESTORE (Conversations & Events)
# ==========================================
FIREBASE_PROJECT_ID=likby-production
FIRESTORE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=

# ==========================================
# CLOUDFLARE R2 (Binary Media Storage)
# ==========================================
STORAGE_PROVIDER=local # "local" or "r2"
MEDIA_STORE_DIR=media_store
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=likby-media
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_PRESIGNED_URL_TTL_SECONDS=300
R2_MAX_UPLOAD_BYTES=20971520 # 20 MB

# ==========================================
# DURABLE OUTBOX & CROSS-SERVICE RELIABILITY
# ==========================================
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SECONDS=2
OUTBOX_BACKOFF_MAX_SECONDS=300
REQUEST_TIMEOUT_SECONDS=20
SHUTDOWN_GRACE_SECONDS=20

# ==========================================
# SOCIAL & ENTITLEMENT LIMITS
# ==========================================
DEFAULT_FRIEND_LIMIT=3
DEFAULT_DAILY_SEARCH_LIMIT=3
DEFAULT_DAILY_REQUEST_LIMIT=5

# ==========================================
# SECURITY & RETENTION
# ==========================================
TRANSCRIPT_RETENTION_DAYS=365
MEDIA_RETENTION_DAYS=365
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WEBHOOK_RPS=30
USER_MESSAGE_RATE_LIMIT=5
CRON_SECRET=change_me_to_a_random_32_char_hex_string

# ==========================================
# PAYMENT INTEGRATIONS (Optional)
# ==========================================
PAYMENT_MODE=test # "test" or "live"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================
# AI INTEGRATION (Optional)
# ==========================================
AI_ENABLED=false
AI_PROVIDER=mock # "groq", "gemini", or "mock"
AI_API_KEY=
