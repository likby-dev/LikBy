# LikBy Configuration Template (.env.example)
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server Networking
HOST=0.0.0.0
PORT=8000
BASE_URL=https://your-domain.onrender.com

# Telegram Platform Credentials
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
WEBHOOK_SECRET_TOKEN=change_me_to_a_random_32_char_hex_string
BOT_MODE=webhook

# Database Configuration
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite+aiosqlite:////data/likby.db
DATABASE_DIRECT_URL=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# AI Feature Flags (Optional)
AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=

# Rate Limiting
RATE_LIMIT_WEBHOOK_RPS=30
USER_MESSAGE_RATE_LIMIT=5
